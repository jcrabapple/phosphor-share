{
	"manifest_version": 3,
	"name": "Phosphor Share",
	"version": "1.1.0",
	"description": "Share any page as a new topic on Phosphor (bbs.snakepit.us) and keep an unread-alert badge.",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"permissions": ["alarms", "storage", "tabs"],
	"host_permissions": ["https://bbs.snakepit.us/*"],
	"browser_specific_settings": {
		"gecko": {
			"id": "phosphor-share@snakepit.us",
			"strict_min_version": "140.0",
			"update_url": "https://bbs.snakepit.us/extensions/firefox/updates.json",
			"data_collection_permissions": {
				"required": ["browsingActivity"]
			}
		}
	},
	"background": {
		"service_worker": "background.js",
		"scripts": ["background.js"]
	},
	"action": {
		"default_title": "Share to Phosphor",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	}
}
